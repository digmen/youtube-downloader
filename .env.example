BOT_TOKEN=123456:ABC-DEF...
# Твой Telegram id (владелец, всегда допущен). Узнать свой/чужой id: @userinfobot
OWNER_ID=1145935758
ADMIN_CHAT_ID=1145935758
# Новых людей добавлять НЕ сюда — при первом сообщении бот сам присылает владельцу
# карточку «разрешить/отклонить» (см. src/access.js). Список решённых — data/allowed.json.

YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
TMP_DIR=./tmp

QUEUE_CONCURRENCY=1
DOWNLOAD_TIMEOUT_SEC=600
MIN_FREE_DISK_MB=2000

# Большие видео идут через локальный Bot API (тот же, что у нарезчика, порт 8082) — лимит 2 ГБ.
MAX_FILESIZE_MB=1900
TELEGRAM_API_ROOT=http://127.0.0.1:8082
